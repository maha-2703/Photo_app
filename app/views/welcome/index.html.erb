<div class="hero-section">
  <h2>Welcome to the Photo Management App!</h2>

  <p class="lead">
    You'll love managing your Photos with our application. Sign up!
  </p>
</div>

<div class="row justify-content-center text-center mt-4">

  <!-- Premium Plan -->

  <div class="col-md-4">

    <div class="plan">

      <h2>Premium Plan</h2>

      <div class="price">
        Price: $10
      </div>

      <div class="features">
        <ul>
          <li>Unlimited Image Uploads</li>
          <li>Responsive design</li>
          <li>Access anywhere</li>
        </ul>
      </div>

      <p>
        <%= link_to 'Sign Up',
        new_user_registration_path,
        class: 'btn btn-primary sign-up' %>
      </p>

    </div>

  </div>

  <!-- Amaze Plan -->

  <div class="col-md-4">

    <div class="plan">

      <h2>Amaze Plan</h2>

      <div class="price">
        Price: $20
      </div>

      <div class="features">
        <ul>
          <li>Unlimited Image Uploads</li>
          <li>Responsive design</li>
          <li>Access anywhere</li>
          <li>Unlimited projects</li>
        </ul>
      </div>

      <p>
        <%= link_to 'Sign Up',
        new_user_registration_path,
        class: 'btn btn-primary sign-up' %>
      </p>

    </div>

  </div>

</div>