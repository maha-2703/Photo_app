<div class="hero-section">
  <h2>Welcome to the Photo Management App!</h2>

  <p class="lead">
    You'll love managing your Photos with our application.
  </p>
</div>

<% if current_user && current_user.premium? %>

  <div class="alert alert-success text-center mt-5">
    Premium Account Activated ✅
  </div>

<% else %>

<div class="row justify-content-center text-center mt-4">

  <!-- Premium Plan -->

  <div class="col-md-4">

    <div class="plan">

      <h2>Premium Plan</h2>

      <div class="price">
        Price: $10
      </div>

      <div class="features">
        <ul>
          <li>Unlimited Image Uploads</li>
          <li>Responsive design</li>
          <li>Access anywhere</li>
        </ul>
      </div>

      <p>
        <%= link_to 'Buy Now',
         new_payment_path(plan: 'Premium', amount: 50000),
         class: 'btn btn-primary sign-up' %>
      </p>

    </div>

  </div>

  <!-- Amaze Plan -->

  <div class="col-md-4">

    <div class="plan">

      <h2>Amaze Plan</h2>

      <div class="price">
        Price: $20
      </div>

      <div class="features">
        <ul>
          <li>Unlimited Image Uploads</li>
          <li>Responsive design</li>
          <li>Access anywhere</li>
          <li>Unlimited projects</li>
        </ul>
      </div>

      <p>
       <%= link_to 'Buy Now',
              new_payment_path(plan: 'Amaze', amount: 100000),
              class: 'btn btn-success sign-up' %>
      </p>

    </div>

  </div>

</div>

<% end %>